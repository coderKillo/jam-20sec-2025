code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_6 : source_color;



void fragment() {
// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, UV);
	float n_out6p3 = n_out6p0.b;


// ColorConstant:8
	vec4 n_out8p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// Input:4
	mat4 n_out4p0 = INV_VIEW_MATRIX;


// Input:2
	vec3 n_out2p0 = NORMAL;


// TransformVectorMult:3
	vec3 n_out3p0 = (n_out4p0 * vec4(n_out2p0, 0.0)).xyz;


// DotProduct:5
	vec3 n_in5p1 = vec3(0.00000, 1.00000, 0.00000);
	float n_out5p0 = dot(n_out3p0, n_in5p1);


// Mix:7
	vec3 n_out7p0 = mix(vec3(n_out6p0.xyz), vec3(n_out8p0.xyz), vec3(n_out5p0));


// ColorConstant:11
	vec4 n_out11p0 = vec4(0.700000, 0.500000, 0.100000, 1.000000);


// Input:20
	mat4 n_out20p0 = INV_VIEW_MATRIX;


// Input:18
	vec3 n_out18p0 = VERTEX;


// TransformVectorMult:19
	vec3 n_out19p0 = (n_out20p0 * vec4(n_out18p0, 1.0)).xyz;


// VectorDecompose:16
	float n_out16p0 = n_out19p0.x;
	float n_out16p1 = n_out19p0.y;
	float n_out16p2 = n_out19p0.z;


// FloatOp:17
	float n_in17p1 = 5.00000;
	float n_out17p0 = mod(n_out16p0, n_in17p1);


// Compare:14
	float n_in14p1 = 3.00000;
	bool n_out14p0 = n_out17p0 < n_in14p1;


	float n_out13p0;
// Switch:13
	float n_in13p1 = 3.00000;
	float n_in13p2 = 0.00000;
	n_out13p0 = mix(n_in13p2, n_in13p1, float(n_out14p0));


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out11p0.xyz) * vec3(n_out13p0);


// Compare:9
	float n_in9p1 = 0.70000;
	bool n_out9p0 = n_out6p3 > n_in9p1;


// Mix:10
	vec3 n_in10p0 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out10p0 = mix(n_in10p0, n_out12p0, vec3(n_out9p0 ? 1.0 : 0.0));


// Output:0
	ALBEDO = n_out7p0;
	EMISSION = n_out10p0;


}
